# ============================================================
# CRUX 抱石 · 环境变量模板
# 复制为 .env.local 后填写；.env.local 已在 .gitignore 中，不会提交
# ============================================================

# ---------------- AI 分析（必填）----------------
# 获取地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# 视频分析模型（默认 gemini-2.5-flash，与 AI Studio 里非 0/0 配额的模型一致）
# 上传视频请压到约 3.5MB 以内（Vercel 请求体上限约 4.5MB）
# 勿用 gemini-2.0-flash / 2.0-flash-lite / 2.5-flash-lite（许多免费 Key 配额为 0/0）
GEMINI_MODEL=gemini-2.5-flash

# ---------------- Supabase（账户 + 云端分析记录）----------------
# 控制台：https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# service_role 密钥：仅服务端 Route Handler 使用，绝对不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 可选：数据库直连 URI（Project Settings → Database → Connection string），
# 只用于命令行执行 supabase/migrations/*.sql；运行时不需要
SUPABASE_DB_URL=

# 会话签名密钥：随机长字符串（至少 16 字符），切勿泄露
AUTH_SECRET=

# 建表：打开 Supabase 控制台 → SQL Editor → 粘贴执行 supabase/migrations/0001_init.sql
# 详细步骤见 supabase/README.md

# ---------------- 异步分析（部署到 Vercel 时必需）----------------
# Vercel 控制台 → Storage → Blob → 创建并连接项目后自动注入
# 本地开发可从 Vercel Dashboard 复制 BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# ---------------- 兼容旧部署（可选）----------------
# 已配置 Supabase 时优先走 Supabase；未配置则回退到 Vercel Postgres / Neon
# POSTGRES_URL=
# DATABASE_URL=

# ---------------- 站点公开地址（SEO / sitemap / Open Graph）----------------
# 不要以斜杠结尾，例如 https://bouldering-ai-coach.vercel.app
NEXT_PUBLIC_SITE_URL=https://bouldering-ai-coach.vercel.app
