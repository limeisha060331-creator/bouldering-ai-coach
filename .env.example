# ============================================================
# CRUX 抱石 · 环境变量模板
# 复制为 .env.local 后填写；.env.local 已在 .gitignore 中，不会提交
# ============================================================

# ---------------- AI 分析（必填）----------------
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_api_key_here

# 视觉分析模型（默认 deepseek-flash，支持图片输入）
# 视频在浏览器本地抽成 16 张关键帧后上传，原片不出本机
DEEPSEEK_MODEL=deepseek-flash

# ---------------- 网页端 Agent 运行时（可选）----------------
# on: 模型 → 工具 → 事实 → 上下文 → 模型 → 校验；off: 原来的单次 DeepSeek
AGENT_RUNTIME=on
# Agent 失败后是否回退单次 DeepSeek；安全红线失败不会回退
AGENT_FALLBACK=on

# ---------------- Supabase（Auth + 数据库 + Storage）----------------
# 控制台：https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# 浏览器端使用 publishable / anon key；它只受 RLS 保护，不会绕过权限
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# service_role 密钥：仅服务端 Route Handler 使用，绝对不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 可选：数据库直连 URI（Project Settings → Database → Connection string），
# 只用于命令行执行 supabase/migrations/*.sql；运行时不需要
SUPABASE_DB_URL=

# 建表：打开 Supabase 控制台 → SQL Editor → 依次执行 0001、0002、0003
# 0003 会把账号切换到 Supabase Auth，并创建私有 Storage bucket `media`
# 详细步骤见 supabase/README.md

# ---------------- 异步分析（部署到 Vercel 时必需）----------------
# Vercel 控制台 → Storage → Blob → 创建并连接项目后自动注入
# 本地开发可从 Vercel Dashboard 复制 BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# ---------------- 兼容旧部署（可选）----------------
# 已配置 Supabase 时优先走 Supabase；未配置则回退到 Vercel Postgres / Neon
# POSTGRES_URL=
# DATABASE_URL=

# ---------------- 站点公开地址（SEO / sitemap / Open Graph）----------------
# 不要以斜杠结尾，例如 https://bouldering-ai-coach.vercel.app
NEXT_PUBLIC_SITE_URL=https://bouldering-ai-coach.vercel.app
